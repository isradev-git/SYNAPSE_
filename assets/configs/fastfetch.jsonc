{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ·  ",
        "color": {
            "keys": "red",
            "title": "bright_white"
        },
        "stat": {
            "bar": {
                "charElapsed": "█",
                "charTotal": "░",
                "width": 16,
                "border": true,
                "borderLeft": "[",
                "borderRight": "]"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{6}{user-name}@{host-name}{}"
        },
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        {
            "type": "terminal",
            "key": "Term"
        },
        "separator",
        "cpu",
        {
            "type": "gpu",
            "detectionMethod": "pci"
        },
        {
            "type": "memory",
            "format": "{used} / {total}  ({percentage}%)"
        },
        {
            "type": "disk",
            "key": "Disk (/)",
            "folders": "/"
        },
        "separator",
        "colors"
    ]
}
